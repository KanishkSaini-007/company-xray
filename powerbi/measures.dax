-- DAX measures for the Company X-Ray dashboard.
-- Assumes two tables: Prices (Date, Close, Ticker, Company, Currency) and
-- Segments (company, year/period, segment/product_group, revenue, plus growth/margin where available).

-- ===== Price card =====
Latest Price =
CALCULATE (
    MAX ( Prices[Close] ),
    FILTER ( Prices, Prices[Date] = MAX ( Prices[Date] ) )
)

Previous Close =
CALCULATE (
    MAX ( Prices[Close] ),
    FILTER ( Prices, Prices[Date] = MAX ( Prices[Date] ) - 1 )
)

Daily Change % =
DIVIDE ( [Latest Price] - [Previous Close], [Previous Close] )

52W High =
MAX ( Prices[Close] )

52W Low =
MIN ( Prices[Close] )

Distance from 52W High % =
DIVIDE ( [Latest Price] - [52W High], [52W High] )

1Y Return % =
DIVIDE (
    [Latest Price]
        - CALCULATE ( MAX ( Prices[Close] ), FILTER ( Prices, Prices[Date] = MIN ( Prices[Date] ) ) ),
    CALCULATE ( MAX ( Prices[Close] ), FILTER ( Prices, Prices[Date] = MIN ( Prices[Date] ) ) )
)

-- ===== Segment ladder (lowest to highest) =====
Segment Revenue =
SUM ( Segments[Revenue] )

Total Company Revenue =
CALCULATE ( SUM ( Segments[Revenue] ), ALL ( Segments[Segment] ) )

Segment Share % =
DIVIDE ( [Segment Revenue], [Total Company Revenue] )

Segment Rank =
RANKX ( ALL ( Segments[Segment] ), [Segment Revenue], , ASC, Dense )

Weakest Segment =
CALCULATE (
    FIRSTNONBLANK ( Segments[Segment], 1 ),
    FILTER ( ALL ( Segments[Segment] ), [Segment Rank] = 1 )
)

-- Where the filing gives growth (Reliance yoy, Nestle organic growth):
Segment Growth % =
AVERAGE ( Segments[GrowthPct] )

-- RAG status: red if growth < 0, amber if growth < company average, green otherwise
Segment Status =
VAR g = [Segment Growth %]
VAR avgG = CALCULATE ( AVERAGE ( Segments[GrowthPct] ), ALL ( Segments[Segment] ) )
RETURN
    SWITCH (
        TRUE,
        g < 0, "Red",
        g < avgG, "Amber",
        "Green"
    )
